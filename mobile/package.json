{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~56.0.20",
    "expo-dev-client": "~56.0.25",
    "expo-notifications": "~56.0.24",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync-data": "node -e \"require('fs').copyFileSync('../data.json','./data.json')\"",
    "prestart": "npm run sync-data",
    "preandroid": "npm run sync-data",
    "preios": "npm run sync-data",
    "preweb": "npm run sync-data",
    "smoke:quiz": "npm run sync-data && node scripts/smoke-quiz-engine.ts",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:alignment": "npm run sync-data && node scripts/test-answer-alignment.ts"
  },
  "private": true
}
